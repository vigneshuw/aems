[Unit]
Description=AEMS board TCP daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aems
Group=aems
WorkingDirectory=/var/lib/aems-server
ExecStart=/opt/aems/venv/bin/aems-boardd --config /etc/aems-server/config.toml
Restart=always
RestartSec=2

# Creates /run/aems-server owned by User/Group before ExecStart. The daemon
# places its Unix control socket in this directory.
RuntimeDirectory=aems-server
RuntimeDirectoryMode=0775

# TCP port 10 is privileged on Linux. This capability lets the daemon bind it
# without running the Python process as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
